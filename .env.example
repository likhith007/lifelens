# Backend only — Gemini key is in Secret Manager (run ./scripts/setup-secrets.sh)
# Firebase client config is in frontend/.env (VITE_FIREBASE_*)

FIREBASE_PROJECT_ID=lifelens-apac-04429
GCP_PROJECT_ID=lifelens-apac-04429
GEMINI_API_KEY_SECRET_ID=GEMINI_API_KEY

# Firebase Admin JWT verification (Service Accounts → Generate new private key)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Banking demo API (local prototype)
BANKING_ALLOW_RESET=true
# BANKING_API_KEY=optional-shared-secret-for-X-API-Key-header
